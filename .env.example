# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only admin and customer session cookies.
SESSION_SECRET="replace_with_random_32_byte_hex_secret"

# ADMIN_EMAIL / ADMIN_PASSWORD: Credentials for the Store Admin Dashboard.
ADMIN_EMAIL="admin@zariandloom.com"
ADMIN_PASSWORD="replace_with_strong_admin_password"

# PAYMENT_GATEWAY_PROVIDER: Optional online payment gateway ("razorpay" or "stripe").
# Leave empty to use built-in configurable checkout gateway test mode.
PAYMENT_GATEWAY_PROVIDER=""
PAYMENT_GATEWAY_KEY_ID=""
PAYMENT_GATEWAY_KEY_SECRET=""

# OPTIONAL FIREBASE CLIENT CONFIG (if migrating persistence to your own Firebase project)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

